# Model Configuration
RLM_MODEL=gemini/gemini-1.5-flash
RLM_MAX_ITERATIONS=30

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Rate Limiting (General)
RLM_RPM=60
RLM_MAX_CONCURRENT=30
RLM_MAX_BURST=5

# Provider Specific Rate Limits (JSON string)
# RLM_PROVIDER_LIMITS='{"mistral": {"requests_per_minute": 30, "max_burst": 1, "max_concurrent": 2}}'

# Retry Configuration
RLM_MAX_RETRIES=5
RLM_RETRY_DELAY=1.0

# Web Interface / Database
RLM_DB_URL=sqlite+aiosqlite:///./sessions.db
RLM_LOG_DIR=./logs
