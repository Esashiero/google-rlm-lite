# ADK-RLM Configuration
# Copy this file to .env and fill in your API keys

# Model Configuration
MODEL_NAME=mistral/mistral-large-latest
MAX_ITERATIONS=10

# Rate Limiting (adjust based on your API tier)
# Mistral rate limits vary by tier:
# - Free tier: ~60 RPM (1 req/sec)
# - Scale tier: Higher limits
RLM_RPM=60
RLM_MAX_CONCURRENT=5
RLM_MAX_BURST=3
RLM_MAX_RETRIES=10
RLM_RETRY_DELAY=2.0

# API Keys
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Other providers (uncomment if needed)
# GEMINI_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
